 "body": "<style>@import url(\"https://fonts.googleapis.com/css2?family=IM+Fell+English&family=Pinyon+Script&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap\");a[x-apple-data-detectors]{color:inherit!important;text-decoration:none!important;font-size:inherit!important;font-family:inherit!important;font-weight:inherit!important;line-height:inherit!important}.hd-wrap,.hd-inner{background-color:#2c2c2e!important;color:#d1d1d6!important}.hd-inner{width:600px;max-width:100%;margin:0 auto}.hd-root{color-scheme:dark;background-color:#2c2c2e}.hd-appearance input{position:absolute;opacity:0;pointer-events:none;width:0;height:0;margin:0}.hd-appearance{display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:6px;margin:14px 0 0;font:500 12px -apple-system,BlinkMacSystemFont,'Helvetica Neue',Helvetica,Arial,sans-serif;color:#8e8e93}.hd-appearance span{margin-right:4px;color:#8e8e93}.hd-appearance label{padding:5px 11px;font:500 12px -apple-system,BlinkMacSystemFont,'Helvetica Neue',Helvetica,Arial,sans-serif;color:#8e8e93;background:transparent;border:1px solid #48484a;border-radius:999px;cursor:pointer}.hd-appearance input:checked + label{color:#2c2c2e;background:#f2f2f7;border-color:#f2f2f7}.hd-root:has(#hd-t-light:checked){color-scheme:light;background-color:#ffffff}.hd-root:has(#hd-t-light:checked) .hd-wrap,.hd-root:has(#hd-t-light:checked) .hd-inner,.hd-root:has(#hd-t-light:checked) .hd-body{background-color:#ffffff!important;color:#1d1a16!important}.hd-root:has(#hd-t-light:checked) .hd-ink,.hd-root:has(#hd-t-light:checked) .hd-inkrule{color:#1d1a16!important;border-top-color:#1d1a16!important;border-bottom-color:#1d1a16!important}.hd-root:has(#hd-t-light:checked) .hd-muted{color:#6b6358!important}.hd-root:has(#hd-t-light:checked) .hd-accent{color:#8b2a1d!important}.hd-root:has(#hd-t-light:checked) .hd-rule{border-color:#d9d0bf!important;border-top-color:#d9d0bf!important;border-bottom-color:#d9d0bf!important}.hd-root:has(#hd-t-light:check