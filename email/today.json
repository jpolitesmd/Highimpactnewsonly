!important}.hd-root:has(#hd-t-dark:checked) .hd-muted{color:#8e8e93!important}.hd-root:has(#hd-t-dark:checked) .hd-accent{color:#e08a6f!important}.hd-root:has(#hd-t-dark:checked) .hd-rule{border-color:#48484a!important;border-top-color:#48484a!important;border-bottom-color:#48484a!important}.hd-root:has(#hd-t-dark:checked) .hd-box{background:#3a3a3c!important;background-color:#3a3a3c!important;border-color:#48484a!important;color:#d1d1d6!important}.hd-root:has(#hd-t-dark:checked) .hd-appearance span,.hd-root:has(#hd-t-dark:checked) .hd-appearance label{color:#8e8e93;border-color:#48484a}.hd-root:has(#hd-t-dark:checked) .hd-appearance input:checked + label{color:#2c2c2e;background:#f2f2f7;border-color:#f2f2f7}@media(prefers-color-scheme:light){.hd-root:has(#hd-t-auto:checked){color-scheme:light;background-color:#ffffff}.hd-root:has(#hd-t-auto:checked) .hd-wrap,.hd-root:has(#hd-t-auto:checked) .hd-inner,.hd-root:has(#hd-t-auto:checked) .hd-body{background-color:#ffffff!important;color:#1d1a16!important}.hd-root:has(#hd-t-auto:checked) .hd-ink,.hd-root:has(#hd-t-auto:checked) .hd-inkrule{color:#1d1a16!important;border-top-color:#1d1a16!important;border-bottom-color:#1d1a16!important}.hd-root:has(#hd-t-auto:checked) .hd-muted{color:#6b6358!important}.hd-root:has(#hd-t-auto:checked) .hd-accent{color:#8b2a1d!important}.hd-root:has(#hd-t-auto:checked) .hd-rule{border-color:#d9d0bf!important;border-top-color:#d9d0bf!important;border-bottom-color:#d9d0bf!important}.hd-root:has(#hd-t-auto:checked) .hd-box{background:#f5f5f7!important;background-color:#f5f5f7!important;border-color:#d9d0bf!important;color:#1d1a16!important}.hd-root:has(#hd-t-auto:checked) .hd-appearance span,.hd-root:has(#hd-t-auto:checked) .hd-appearance label{color:#6b6358;border-color:#d9d0bf}.hd-root:has(#hd-t-auto:checked) .hd-appearance input:checked + label{color:#ffffff;background:#1d1a16;border-color:#1d1a16}}@media(prefers-color-scheme:dark){.hd-root:has(#hd-t-auto:checked){color-scheme:dark;background-color:#2c2c2e}.hd-root:has(#hd-t-auto:checked) .hd-wrap,.hd-root:has(#hd-t-auto:checked) .hd-inner,.hd-root:has(#hd-t-auto:checked) .hd-body{background-color:#2c2c2e!important;color:#d1d1d6!important}.hd-root:has(#hd-t-auto:checked) .hd-ink,.hd-root:has(#hd-t-auto:checked) .hd-inkrule{color:#f2f2f7!important;border-top-color:#f2f2f7!important;border-bottom-color:#f2f2f7!important}.hd-root:has(#hd-t-auto:checked) .hd-muted{color:#8e8e93!important}.hd-root:has(#hd-t-auto:checked) .hd-accent{color:#e08a6f!important}.hd-root:has(#hd-t-auto:checked) .hd-rule{border-color:#48484a!important;border-top-color:#48484a!important;border-bottom-color:#48484a!important}.hd-root:has(#hd-t-auto:checked) .hd-box{background:#3a3a3c!important;background-color:#3a3a3c!important;border-color:#48484a!important;color:#d1d1d6!important}.hd-root:has(#hd-t-auto:checked) .hd-appearance span,.hd-root:has(#hd-t-auto:checked) .hd-appearance label{color:#8e8e93;border-color:#48484a}.hd-root:has(#hd-t-auto:checked) .hd-appearance input:checked + label{color:#2c2c2e;background:#f2f2f7;border-color:#f2f2f7}}</style>\n<div class=\"hd-root\">\n<table role=\"presentation\" class=\"hd-wrap\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#2c2c2e\" style=\"width:100%;border-collapse:collapse;background-color:#2c2c2e\"><tr><td align=\"center\" valign=\"top\" bgcolor=\"#2c2c2e\" style=\"padding:0;background-color:#2c2c2e;text-align:center\"><table role=\"presentation\" class=\"hd-inner\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#2c2c2e\" style=\"width:600px;max-width:100%;border-collapse:collapse;background-color:#2c2c2e;margin:0 auto;text-align:left\"><tr><td class=\"hd-body\" bgcolor=\"#2c2c2e\" style=\"padding:6px 16px 20px;background-color:#2c2c2e;color:#d1d1d6;font-family:'Source Serif 4','Source Serif Pro',Georgia,'Times New Roman',Times,serif;font-size:15px;line-height:1.5;text-align:left\">\n<p class=\"hd-inkrule hd-ink\" style=\"margin:0;padding:6px 0 5px;border-top:3px double #f2f2f7;border-bottom:1px solid #f2f2f7;text-align:center;font-family:-apple-system,BlinkMacSystemFont,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:9px;font-weight:600;letter-spacing:1.6px;text-transform:uppercase;color:#f2f2f7\">Spin-free news · Ranked by impact</p>\n<p style=\"margin:16px 0 0;text-align:center;white-space:nowrap;line-height:1.1\"><a href=\"https://hinewsdaily.com/\" style=\"text-decoration:none\"><span class=\"hd-ink\" style=\"font-family:'IM Fell English',Georgia,'Times New Roman',serif;font-size:25px;letter-spacing:1px;color:#f2f2f7\">HIGH</span> <span class=\"hd-accent\" style=\"font-family:'Pinyon Script','Snell Roundhand',cursive;font-size:31px;margin:0 3px;color:#e08a6f\">impact</span> <span class=\"hd-ink\" style=\"font-family:'IM Fell English',Georgia,'Times New Roman',serif;font-size:25px;letter-spacing:1px;color:#f2f2f7\">NEWS</span> <span class=\"hd-accent\" style=\"font-family:'Pinyon Script','Snell Roundhand',cursive;font-size:31px;margin:0 3px;color:#e08a6f\">daily</span></a></p>\n<p style=\"margin:8px 0 0;text-align:center;line-height:0\"><img src=\"https://hinewsdaily.com/assets/email/orn-head.png\" alt=\"\" width=\"260\" height=\"20\" style=\"display:inline-block;width:260px;max-width:80%;height:auto;border:0\"></p>\n<div class=\"hd-appearance\" role=\"group\" aria-label=\"Appearance\"><span>Appearance</span><input type=\"radio\" name=\"hd-theme\" id=\"hd-t-auto\" value=\"auto\" checked><label for=\"hd-t-auto\">Auto</label><input type=\"radio\" name=\"hd-theme\" id=\"hd-t-light\" value=\"light\"><label for=\"hd-t-light\">Light</label><input type=\"radio\" name=\"hd-theme\" id=\"hd-t-sepia\" value=\"sepia\"><label for=\"hd-t-sepia\">Sepia</label><input type=\"radio\" name=\"hd-theme\" id=\"hd-t-dark\" value=\"dark\"><label for=\"hd-t-dark\">Dark</label></div>\n<p class=\"hd-accent\" style=\"margin:18px 0 0;text-align:center;font-family:-apple-system,BlinkMacSystemFont,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:11px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;color:#e08a6f\">Morning edition · Thursday, October 1</p>\n<p class=\"hd-muted\" style=\"margin:4px 0 6px;text-align:center;font-family:'Source Serif 4','Source Serif Pro',Georgia,'Times New Roman',Times,serif;font-style:italic;font-size:14px;color:#8e8e93\">What happened overnight, and yesterday&#x27;s biggest stories. Five minutes. No spin.</p>\n<p class=\"hd-muted hd-rule\" style=\"margin:26px 0 0;padding:0 0 6px;border-bottom:1px solid #48484a;font-family:-apple-system,BlinkMacSystemFont,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:12px;font-weight:700;letter-spacing:1.6px;text-transform:uppercase;color:#8e8e93\">Overnight</p>\n<h3 class=\"hd-ink\" style=\"margin:20px 0 8px;font-family:'Source Serif 4','Source Serif Pro',Georgia,'Times New Roman',Times,serif;font-size:18px;line-height:1.3;font-weight:600;color:#f2f2f7\">Tennessee halted scheduled executions after Christa Pike appeared still breathing following a lethal injection attempt.</h3>\n<p class=\"hd-body\" style=\"margin:0 0 10px;font-family:'Source Serif 4','Source Serif Pro',Georgia,'Times New Roman',Times,serif;font-size:15px;line-height:1.5;color:#d1d1d6\">Witnesses said Pike still appeared to be breathing about an hour after pentobarbital was administered late Wednesday at Riverbend Maximum Security Institution in Nashville; she was taken to a hospital. Gov. Bill Lee ordered a third-party review and said the remaining scheduled execution will not be carried out this year. Earlier Wednesday the Supreme Court vacated a Sixth Circuit stay (Nelsen v. Pike, 26A428), clearing Tennessee to proceed before the warrant expired at midnight; Justices Sotomayor, Kagan and Jackson dissented. Pike, 50, was convicted of the 1995 murder of Colleen Slemmer and was the only woman on Tennessee&#x27;s death row.</p>\n<p class=\"hd-muted\" style=\"margin:0;font-family:-apple-system,BlinkMacSystemFont,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;line-height:1.45;color:#8e8e93\"><img src=\"https://hinewsdaily.com/assets/email/impact-4.png\" alt=\"\" width=\"50\" height=\"16\" style=\"width:50px;height:16px;vertical-align:-3px;border:0\"> <b class=\"hd-ink\" style=\"color:#f2f2f7\">Impact 4/5.</b> A failed lethal injection and a statewide pause on further executions, after the Supreme Court cleared the state to proceed the same day. <a class=\"hd-accent\" href=\"https://www.supremecourt.gov/opinions/25pdf/26a428_4f15.pdf\" style=\"color:#e08a6f;text-decoration:none;font-weight:600\">ABC News / Supreme Court ↗</a></p>\n<p style=\"margin:22px 0 0;text-align:center;line-height:0\"><img src=\"https://hinewsdaily.com/assets/email/orn-sep.png\" alt=\"\" width=\"180\" height=\"18\" style=\"display:inline-block;width:180px;max-width:60%;height:auto;border:0\"></p>\n<h3 class=\"hd-ink\" style=\"margin:22px 0 8px;font-family:'Source Serif 4','Source Serif Pro',Georgia,'Times New Roman',Times,serif;font-size:18px;line-height:1.3;font-weight:600;color:#f2f2f7\">A State Department rule removed Syria from the blanket ban on U.S. defense-trade licenses.</h3>\n<p class=\"hd-body\" style=\"margin:0 0 10px;font-family:'Source Serif 4','Source Serif Pro',Georgia,'Times New Roman',Times,serif;font-size:15px;line-height:1.5;color:#d1d1d6\">The International Traffic in Arms Regulations final rule, effective Oct. 1, takes Syria off ITAR §126.1&#x27;s list of countries subject to a policy of denial for defense exports and imports. License requests will be reviewed case by case. The change follows the secretary&#x27;s Aug. 19 defense-trade policy shift after statutory barriers, including terrorism-related restrictions, were lifted or waived. Belarus, Burma, China, Cuba, Iran, North Korea and Venezuela remain on the denial list.</p>\n<p class=\"hd-muted\" style=\"margin:0;font-family:-apple-system,BlinkMacSystemFont,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;line-height:1.45;color:#8e8e93\"><img src=\"https://hinewsdaily.com/assets/email/impact-3.png\" alt=\"\" width=\"50\" height=\"16\" style=\"width:50px;height:16px;vertical-align:-3px;border:0\"> <b class=\"hd-ink\" style=\"color:#f2f2f7\">Impact 3/5.</b> Opens a path to licensed U.S. defense sales and services to Syria that were previously denied by default. <a class=\"hd-accent\" href=\"https://www.federalregister.gov/documents/2026/10/01/2026-20082/international-traffic-in-arms-regulations-syria-country-policy-revision\" style=\"color:#e08a6f;text-decoration:none;font-weight:600\">Federal Register ↗</a></p>\n<p style=\"margin:22px 0 0;text-align:center;line-height:0\"><img src=\"https://hinewsdaily.com/assets/email/orn-sep.png\" alt=\"\" width=\"180\" height=\"18\" style=\"display:inline-block;width:180px;max-width:60%;height:auto;border:0\"></p>\n<h3 class=\"hd-ink\" style=\"margin:22px 0 8px;font-family:'Source Serif 4','Source Serif Pro',Georgia,'Times New Roman',Times,serif;font-size:18px;line-height:1.3;font-weight:600;color:#f2f2f7\">USDA rewrote Rural Energy for America grants so projects must already be built before applicants can apply.</h3>\n<p class=\"hd-body\" style=\"margin:0 0 10px;font-family:'Source Serif 4','Source Serif Pro',Georgia,'Times New Roman',Times,serif;font-size:15px;line-height:1.5;color:#d1d1d6\">The Rural Business-Cooperative Service final rule, published Oct. 1 and effective Oct. 16, shifts REAP renewable-energy and efficiency grants to a post-completion model using 12 months of actual performance data. It bars solar and wind systems on Farm Service Agency–certified cropland, bars components from foreign-adversary countries, limits applicants to highest-level owners, and replaces state contests with national scoring. Comments are due Nov. 2.</p>\n<p class=\"hd-muted\" style=\"margin:0;font-family:-apple-system,BlinkMacSystemFont,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;line-height:1.45;color:#8e8e93\"><img src=\"https://hinewsdaily.com/assets/email/impact-3.png\" alt=\"\" width=\"50\" height=\"16\" style=\"width:50px;height:16px;vertical-align:-3px;border:0\"> <b class=\"hd-ink\" style=\"color:#f2f2f7\">Impact 3/5.</b> Changes who can get rural energy grants and when, with new farmland and foreign-component limits. <a class=\"hd-accent\" href=\"https://www.federalregister.gov/documents/2026/10/01/2026-20178/unleashing-american-energy-and-economic-prosperity-rural-energy-for-america-program-reap\" style=\"color:#e08a6f;text-decoration:none;font-weight:600\">Federal Register ↗</a></p>\n<p style=\"margin:22px 0 0;text-align:center;line-height:0\"><img src=\"https://hinewsdaily.com/assets/email/orn-sep.png\" alt=\"\" width=\"180\" height=\"18\" style=\"display:inline-block;width:180px;max-width:60%;height:auto;border:0\"></p>\n<h3 class=\"hd-ink\" style=\"margin:22px 0 8px;font-family:'Source Serif 4','Source Serif Pro',Georgia,'Times New Roman',Times,serif;font-size:18px;line-height:1.3;font-weight:600;color:#f2f2f7\">The Yankees, Padres and White Sox each swept their MLB Wild Card Series; the Phillies forced a Game 3.</h3>\n<p class=\"hd-body\" style=\"margin:0 0 10px;font-family:'Source Serif 4','Source Serif Pro',Georgia,'Times New Roman',Times,serif;font-size:15px;line-height:1.5;color:#d1d1d6\">On Wednesday the Yankees beat the Red Sox 9-2, the White Sox beat the Astros 7-3 and the Padres beat the Cubs 4-1 to advance to the Division Series. The Phillies beat the Braves 4-3 in 10 innings, forcing a decisive Game 3 on Thursday.</p>\n<p class=\"hd-muted\" style=\"margin:0;font-family:-apple-system,BlinkMacSystemFont,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;line-height:1.45;color:#8e8e93\"><img src=\"https://hinewsdaily.com/assets/email/impact-3.png\" alt=\"\" width=\"50\" height=\"16\" style=\"width:50px;height:16px;vertical-align:-3px;border:0\"> <b class=\"hd-ink\" style=\"color:#f2f2f7\">Impact 3/5.</b> Three Wild Card Series are over; one winner-take-all game remains before the Division Series. <a class=\"hd-accent\" href=\"https://www.reuters.com/sports/mlb-roundup-yankees-white-sox-padres-complete-wild-card-sweeps--flm-2026-10-01/\" style=\"color:#e08a6f;text-decoration:none;font-weight:600\">Reuters / MLB ↗</a></p>\n<p style=\"margin:22px 0 0;text-align:center;line-height:0\"><img src=\"https://hinewsdaily.com/assets/email/orn-sep.png\" alt=\"\" width=\"180\" height=\"18\" style=\"display:inline-block;width:180px;max-width:60%;height:auto;border:0\"></p>\n<h3 class=\"hd-ink\" style=\"margin:22px 0 8px;font-family:'Source Serif 4','Source Serif Pro',Georgia,'Times New Roman',Times,serif;font-size:18px;line-height:1.3;font-weight:600;color:#f2f2f7\">The Senate confirmed Keith Sonderling as Labor secretary.</h3>\n<p class=\"hd-body\" style=\"margin:0 0 10px;font-family:'Source Serif 4','Source Serif Pro',Georgia,'Times New Roman',Times,serif;font-size:15px;line-height:1.5;color:#d1d1d6\">The nomination was confirmed 47-41 on a party-line vote late Wednesday (roll call 256), with 12 senators not voting. Sonderling had been serving as acting labor secretary. The vote came after the Senate earlier Wednesday invoked cloture on the nomination 53-47.</p>\n<p class=\"hd-muted\" style=\"margin:0;font-family:-apple-system,BlinkMacSystemFont,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;line-height:1.45;color:#8e8e93\"><img src=\"https://hinewsdaily.com/assets/email/impact-3.png\" alt=\"\" width=\"50\" height=\"16\" style=\"width:50px;height:16px;vertical-align:-3px;border:0\"> <b class=\"hd-ink\" style=\"color:#f2f2f7\">Impact 3/5.</b> Fills the Cabinet labor post that oversees workplace rules, wages and federal labor enforcement. <a class=\"hd-accent\" href=\"https://www.senate.gov/legislative/LIS/roll_call_votes/vote1192/vote_119_2_00256.htm\" style=\"color:#e08a6f;text-decoration:none;font-weight:600\">U.S. Senate ↗</a></p>\n<p class=\"hd-muted hd-rule\" style=\"margin:34px 0 0;padding:14px 0 6px;border-top:3px double #48484a;border-bottom:1px solid #48484a;font-family:-apple-system,BlinkMacSystemFont,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:12px;font-weight:700;letter-spacing:1.6px;text-transform:uppercase;color:#8e8e93\">Yesterday&#x27;s biggest stories</p>\n<h3 class=\"hd-ink\" style=\"margin:20px 0 8px;font-family:'Source Serif 4','Source Serif Pro',Georgia,'Times New Roman',Times,serif;font-size:18px;line-height:1.3;font-weight:600;color:#f2f2f7\">The United States ended its anti-ISIS military mission in Iraq, withdrawing the last U.S. troops after more than two decades.</h3>\n<p class=\"hd-body\" style=\"margin:0 0 10px;font-family:'Source Serif 4','Source Serif Pro',Georgia,'Times New Roman',Times,serif;font-size:15px;line-height:1.5;color:#d1d1d6\">Operation Inherent Resolve&#x27;s Iraq mission concluded Wednesday under a 2024 Baghdad-Washington transition plan; roughly 2,500 remaining U.S. forces left, with Iraq assuming full responsibility for security against ISIS remnants. Iran and aligned groups cast the exit as a win. The U.S. and Iraq say they will shift to a bilateral security relationship; concerns remain about militia influence and residual ISIS threats without U.S. air and intelligence support on the ground.</p>\n<p class=\"hd-muted\" style=\"margin:0;font-family:-apple-system,BlinkMacSystemFont,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;line-height:1.45;color:#8e8e93\"><img src=\"https://hinewsdaily.com/assets/email/impact-4.png\" alt=\"\" width=\"50\" height=\"16\" style=\"width:50px;height:16px;vertical-align:-3px;border:0\"> <b class=\"hd-ink\" style=\"color:#f2f2f7\">Impact 4/5.</b> Closes a major U.S. combat footprint in Iraq and reshapes regional security against ISIS and Iran-aligned forces. <a class=\"hd-accent\" href=\"https://www.cbsnews.com/news/us-military-iraq-withdrawal-isis-operation-inherent-resolve-over/\" style=\"color:#e08a6f;text-decoration:none;font-weight:600\">CBS News / BBC ↗</a></p>\n<p style=\"margin:22px 0 0;text-align:center;line-height:0\"><img src=\"https://hinewsdaily.com/assets/email/orn-sep.png\" alt=\"\" width=\"180\" height=\"18\" style=\"display:inline-block;width:180px;max-width:60%;height:auto;border:0\"></p>\n<h3 class=\"hd-ink\" style=\"margin:22px 0 8px;font-family:'Source Serif 4','Source Serif Pro',Georgia,'Times New Roman',Times,serif;font-size:18px;line-height:1.3;font-weight:600;color:#f2f2f7\">A Flydubai pilot stabbed the other pilot on a Dubai-to-Tel Aviv flight and apparently tried to crash the plane, Israel&#x27;s prime minister said.</h3>\n<p class=\"hd-body\" style=\"margin:0 0 10px;font-family:'Source Serif 4','Source Serif Pro',Georgia,'Times New Roman',Times,serif;font-size:15px;line-height:1.5;color:#d1d1d6\">Flight FZ1073 (Dubai to Tel Aviv) transmitted emergency codes including 7500 (unlawful interference), descended thousands of feet, and diverted to Tabuk, Saudi Arabia; Israel scrambled warplanes amid hijacking fears. Netanyahu said one pilot stabbed the other and apparently tried to crash the Boeing 737; Flydubai confirmed a flight-deck altercation, said all passengers were safe, and said motives remain under investigation. Saudi airport officials said both pilots were hospitalized; Saudi and UAE authorities opened investigations.</p>\n<p class=\"hd-muted\" style=\"margin:0;font-family:-apple-system,BlinkMacSystemFont,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;line-height:1.45;color:#8e8e93\"><img src=\"https://hinewsdaily.com/assets/email/impact-4.png\" alt=\"\" width=\"50\" height=\"16\" style=\"width:50px;height:16px;vertical-align:-3px;border:0\"> <b class=\"hd-ink\" style=\"color:#f2f2f7\">Impact 4/5.</b> An in-flight attack on an Israel-bound jet that briefly looked like a hijacking and nearly became a mass-casualty crash. <a class=\"hd-accent\" href=\"https://www.pbs.org/newshour/world/netanyahu-says-a-pilot-on-a-flydubai-flight-stabbed-another-and-apparently-tried-to-crash-the-plane\" style=\"color:#e08a6f;text-decoration:none;font-weight:600\">Associated Press ↗</a></p>\n<p style=\"margin:22px 0 0;text-align:center;line-height:0\"><img src=\"https://hinewsdaily.com/assets/email/orn-sep.png\" alt=\"\" width=\"180\" height=\"18\" style=\"display:inline-block;width:180px;max-width:60%;height:auto;border:0\"></p>\n<h3 class=\"hd-ink\" style=\"margin:22px 0 8px;font-family:'Source Serif 4','Source Serif Pro',Georgia,'Times New Roman',Times,serif;font-size:18px;line-height:1.3;font-weight:600;color:#f2f2f7\">Iran received a formal U.S. response to its proposal to end the war and reopen the Strait of Hormuz.</h3>\n<p class=\"hd-body\" style=\"margin:0 0 10px;font-family:'Source Serif 4','Source Serif Pro',Georgia,'Times New Roman',Times,serif;font-size:15px;line-height:1.5;color:#d1d1d6\">Foreign Minister Abbas Araghchi presented the U.S. response to President Masoud Pezeshkian at Wednesday&#x27;s cabinet meeting after receiving feedback via Qatari mediators in Doha on Tuesday night, officials said. The contents were not disclosed. A Reuters-briefed official said the main disagreement is the sequencing of a seven-day trust-building plan, not its components. President Trump had publicly rejected Iran&#x27;s earlier offer days ago; mediators kept working. Pezeshkian said Iran would seek a &quot;win-win&quot; agreement.</p>\n<p class=\"hd-muted\" style=\"margin:0;font-family:-apple-system,BlinkMacSystemFont,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;line-height:1.45;color:#8e8e93\"><img src=\"https://hinewsdaily.com/assets/email/impact-4.png\" alt=\"\" width=\"50\" height=\"16\" style=\"width:50px;height:16px;vertical-align:-3px;border:0\"> <b class=\"hd-ink\" style=\"color:#f2f2f7\">Impact 4/5.</b> Moves ceasefire and Hormuz reopening talks after Trump&#x27;s public rejection; the strait carries about a fifth of the world&#x27;s oil. <a class=\"hd-accent\" href=\"https://www.therepublic.com/2026/09/30/iran-indicates-its-received-an-official-us-response-to-its-latest-offer-on-ending-the-war/\" style=\"color:#e08a6f;text-decoration:none;font-weight:600\">AP ↗</a></p>\n<p style=\"margin:22px 0 0;text-align:center;line-height:0\"><img src=\"https://hinewsdaily.com/assets/email/orn-sep.png\" alt=\"\" width=\"180\" height=\"18\" style=\"display:inline-block;width:180px;max-width:60%;height:auto;border:0\"></p>\n<h3 class=\"hd-ink\" style=\"margin:22px 0 8px;font-family:'Source Serif 4','Source Serif Pro',Georgia,'Times New Roman',Times,serif;font-size:18px;line-height:1.3;font-weight:600;color:#f2f2f7\">The Ratepayer Protection Act and the Stop Insider Trading Act, both House-passed bills, failed in the Senate.</h3>\n<p class=\"hd-body\" style=\"margin:0 0 10px;font-family:'Source Serif 4','Source Serif Pro',Georgia,'Times New Roman',Times,serif;font-size:15px;line-height:1.5;color:#d1d1d6\">Both needed 60 votes to advance and fell short the same afternoon. The Ratepayer Protection Act (vote 254, 57-43) would have pushed state utility regulators to keep large data-center power and water costs off residential ratepayers; four Democrats — Hassan, Klobuchar, Ossoff and Warnock — joined Republicans; the House had passed it 417-3. The Stop Insider Trading Act (vote 253, 53-47, party-line) would have barred members, spouses and dependent children from buying new publicly traded stocks while allowing sales with advance notice and letting them keep existing holdings. Separately, the Senate voted 53-47 to invoke cloture on Keith Sonderling’s nomination as Labor secretary (vote 255), clearing a procedural step toward a final confirmation vote.</p>\n<p class=\"hd-muted\" style=\"margin:0;font-family:-apple-system,BlinkMacSystemFont,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;line-height:1.45;color:#8e8e93\"><img src=\"https://hinewsdaily.com/assets/email/impact-3.png\" alt=\"\" width=\"50\" height=\"16\" style=\"width:50px;height:16px;vertical-align:-3px;border:0\"> <b class=\"hd-ink\" style=\"color:#f2f2f7\">Impact 3/5.</b> Blocks near-term Senate action on data-center ratepayer costs and on congressional stock-trading limits before the midterm recess. <a class=\"hd-accent\" href=\"https://www.senate.gov/legislative/LIS/roll_call_votes/vote1192/vote_119_2_00254.htm\" style=\"color:#e08a6f;text-decoration:none;font-weight:600\">U.S. Senate ↗</a></p>\n<p style=\"margin:22px 0 0;text-align:center;line-height:0\"><img src=\"https://hinewsdaily.com/assets/email/orn-sep.png\" alt=\"\" width=\"180\" height=\"18\" style=\"display:inline-block;width:180px;max-width:60%;height:auto;border:0\"></p>\n<h3 class=\"hd-ink\" style=\"margin:22px 0 8px;font-family:'Source Serif 4','Source Serif Pro',Georgia,'Times New Roman',Times,serif;font-size:18px;line-height:1.3;font-weight:600;color:#f2f2f7\">Russian strikes on Kyiv and the surrounding region overnight killed four people, including a child, and hit power infrastructure.</h3>\n<p class=\"hd-body\" style=\"margin:0 0 10px;font-family:'Source Serif 4','Source Serif Pro',Georgia,'Times New Roman',Times,serif;font-size:15px;line-height:1.5;color:#d1d1d6\">President Zelenskyy said the main targets were energy infrastructure in Kyiv and the surrounding region. The Russian Defense Ministry claimed hits on a hydroelectric plant, a thermal plant, a substation, an energy storage facility and a data center; Ukrainian officials did not confirm those specific targets and reported hits on civilian areas in at least four Kyiv districts. Ukraine&#x27;s air force said Russia is using ballistic missiles and jet-powered drones that are hard to intercept.</p>\n<p class=\"hd-muted\" style=\"margin:0;font-family:-apple-system,BlinkMacSystemFont,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;line-height:1.45;color:#8e8e93\"><img src=\"https://hinewsdaily.com/assets/email/impact-3.png\" alt=\"\" width=\"50\" height=\"16\" style=\"width:50px;height:16px;vertical-align:-3px;border:0\"> <b class=\"hd-ink\" style=\"color:#f2f2f7\">Impact 3/5.</b> Continues Russia&#x27;s campaign against Ukraine&#x27;s power grid ahead of winter; not a change in the war&#x27;s scope. <a class=\"hd-accent\" href=\"https://thehill.com/homenews/ap/ap-international/ap-russia-pounds-the-kyiv-region-killing-4-and-targeting-the-power-grid/\" style=\"color:#e08a6f;text-decoration:none;font-weight:600\">AP ↗</a></p>\n<p class=\"hd-muted hd-rule\" style=\"margin:34px 0 0;padding:14px 0 6px;border-top:3px double #48484a;border-bottom:1px solid #48484a;font-family:-apple-system,BlinkMacSystemFont,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:12px;font-weight:700;letter-spacing:1.6px;text-transform:uppercase;color:#8e8e93\">This week so far</p>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;border-collapse:collapse\"><tr><td class=\"hd-body hd-rule\" style=\"padding:9px 0;border-bottom:1px solid #48484a;font-family:-apple-system,BlinkMacSystemFont,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.45;color:#d1d1d6\">The Transportation Department finalized lower fuel economy standards for new cars and light trucks. <a class=\"hd-accent\" href=\"https://www.repairerdrivennews.com/2026/09/29/usdot-releases-final-corporate-average-fuel-economy-standards-rule-for-model-years-2022-2031/\" style=\"color:#e08a6f;text-decoration:none;font-weight:600\">Source ↗</a></td></tr><tr><td class=\"hd-body hd-rule\" style=\"padding:9px 0;border-bottom:1px solid #48484a;font-family:-apple-system,BlinkMacSystemFont,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.45;color:#d1d1d6\">A 100% Section 232 tariff on most patented drug imports took effect for companies not covered by the July phase-in. <a class=\"hd-accent\" href=\"https://www.federalregister.gov/documents/2026/04/09/2026-06956/adjusting-imports-of-pharmaceuticals-and-pharmaceutical-ingredients-into-the-united-states\" style=\"color:#e08a6f;text-decoration:none;font-weight:600\">Source ↗</a></td></tr><tr><td class=\"hd-body hd-rule\" style=\"padding:9px 0;border-bottom:1px solid #48484a;font-family:-apple-system,BlinkMacSystemFont,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.45;color:#d1d1d6\">President Trump rejected Iran&#x27;s latest proposal to reopen the Strait of Hormuz and end the war. <a class=\"hd-accent\" href=\"https://www.justsecurity.org/159075/early-edition-september-28-2026/\" style=\"color:#e08a6f;text-decoration:none;font-weight:600\">Source ↗</a></td></tr></table>\n<p class=\"hd-muted hd-rule\" style=\"margin:34px 0 0;padding:14px 0 6px;border-top:3px double #48484a;border-bottom:1px solid #48484a;font-family:-apple-system,BlinkMacSystemFont,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:12px;font-weight:700;letter-spacing:1.6px;text-transform:uppercase;color:#8e8e93\">Also today</p>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;border-collapse:collapse\"><tr><td class=\"hd-body hd-rule\" style=\"padding:9px 0;border-bottom:1px solid #48484a;font-family:-apple-system,BlinkMacSystemFont,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.45;color:#d1d1d6\"><b class=\"hd-ink\" style=\"color:#f2f2f7\">Sports:</b> The Yankees, Braves, Padres and White Sox each won Game 1 of their MLB Wild Card Series on Tuesday. <a class=\"hd-accent\" href=\"https://www.mlb.com/news/yankees-win-al-wild-card-game-1-2026\" style=\"color:#e08a6f;text-decoration:none;font-weight:600\">Source ↗</a></td></tr><tr><td class=\"hd-body hd-rule\" style=\"padding:9px 0;border-bottom:1px solid #48484a;font-family:-apple-system,BlinkMacSystemFont,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.45;color:#d1d1d6\"><b class=\"hd-ink\" style=\"color:#f2f2f7\">ISO20022:</b> Armada Acquisition Corp. II shareholders approved the Evernorth XRP-treasury merger, a step toward a planned Nasdaq listing as XRPN. <a class=\"hd-accent\" href=\"https://crypto.news/xrp-rebounds-past-1-50-as-evernorth-merger-vote/\" style=\"color:#e08a6f;text-decoration:none;font-weight:600\">Source ↗</a></td></tr></table>\n<p class=\"hd-muted hd-rule\" style=\"margin:34px 0 0;padding:14px 0 6px;border-top:3px double #48484a;border-bottom:1px solid #48484a;font-family:-apple-system,BlinkMacSystemFont,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:12px;font-weight:700;letter-spacing:1.6px;text-transform:uppercase;color:#8e8e93\">Coming up</p>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;border-collapse:collapse\"><tr><td valign=\"top\" class=\"hd-accent hd-rule\" style=\"width:64px;padding:9px 10px 9px 0;border-bottom:1px solid #48484a;font-family:-apple-system,BlinkMacSystemFont,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;font-weight:700;color:#e08a6f;white-space:nowrap\">Through Oct 1</td><td class=\"hd-body hd-rule\" style=\"padding:9px 0;border-bottom:1px solid #48484a;font-family:-apple-system,BlinkMacSystemFont,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.45;color:#d1d1d6\">Korea Blockchain Week wraps in Seoul (main conference Sept. 30–Oct. 1).</td></tr><tr><td valign=\"top\" class=\"hd-accent hd-rule\" style=\"width:64px;padding:9px 10px 9px 0;border-bottom:1px solid #48484a;font-family:-apple-system,BlinkMacSystemFont,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;font-weight:700;color:#e08a6f;white-space:nowrap\">Oct 2</td><td class=\"hd-body hd-rule\" style=\"padding:9px 0;border-bottom:1px solid #48484a;font-family:-apple-system,BlinkMacSystemFont,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.45;color:#d1d1d6\">September jobs report, 8:30 a.m. ET.</td></tr><tr><td valign=\"top\" class=\"hd-accent hd-rule\" style=\"width:64px;padding:9px 10px 9px 0;border-bottom:1px solid #48484a;font-family:-apple-system,BlinkMacSystemFont,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;font-weight:700;color:#e08a6f;white-space:nowrap\">Oct 5</td><td class=\"hd-body hd-rule\" style=\"padding:9px 0;border-bottom:1px solid #48484a;font-family:-apple-system,BlinkMacSystemFont,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.45;color:#d1d1d6\">Supreme Court opens its new term and hears Suncor Energy v. Boulder County.</td></tr></table>\n<p class=\"hd-muted\" style=\"margin:30px 0 0;text-align:center;font-family:'Source Serif 4','Source Serif Pro',Georgia,'Times New Roman',Times,serif;font-style:italic;font-size:15px;color:#8e8e93\">That&#x27;s the news. Put the phone down and enjoy your day.</p>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;margin-top:26px;border-collapse:separate\"><tr><td bgcolor=\"#3a3a3c\" class=\"hd-box hd-body\" style=\"padding:18px 16px;background:#3a3a3c;background-color:#3a3a3c;border:1px solid #48484a;border-radius:12px;text-align:center;font-family:-apple-system,BlinkMacSystemFont,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.5;color:#d1d1d6\"><b class=\"hd-ink\" style=\"font-size:15px;color:#f2f2f7\">Know someone who’d like this?</b><br>Forward this email, or send them <a class=\"hd-accent\" href=\"https://hinewsdaily.com/editions/2026-10-01-morning/\" style=\"color:#e08a6f;text-decoration:underline;font-weight:600\">a link to this edition</a>.<br><span class=\"hd-muted\" style=\"font-size:14px;color:#8e8e93\"><i>Forwarded this?</i> <a class=\"hd-accent\" href=\"https://hinewsdaily.com/#subscribe\" style=\"color:#e08a6f;text-decoration:underline;font-weight:600\">Subscribe free</a>.</span></td></tr></table>\n<p class=\"hd-muted\" style=\"margin:22px 0 0;text-align:center;font-family:-apple-system,BlinkMacSystemFont,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;line-height:1.6;color:#8e8e93\"><a class=\"hd-accent\" href=\"https://hinewsdaily.com/editions/2026-10-01-morning